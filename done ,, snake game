<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Snake Game</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #1a1a2e;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #eee;
  }

  h1 {
    margin-bottom: 10px;
    letter-spacing: 2px;
    color: #4ade80;
  }

  #scoreboard {
    display: flex;
    gap: 30px;
    margin-bottom: 12px;
    font-size: 18px;
  }

  #gameCanvas {
    background: #0f0f1e;
    border: 3px solid #4ade80;
    border-radius: 8px;
    box-shadow: 0 0 25px rgba(74, 222, 128, 0.4);
  }

  #message {
    margin-top: 14px;
    font-size: 16px;
    min-height: 24px;
    color: #f87171;
  }

  #restartBtn {
    margin-top: 8px;
    padding: 10px 22px;
    font-size: 15px;
    background: #4ade80;
    border: none;
    border-radius: 6px;
    color: #0f0f1e;
    font-weight: bold;
    cursor: pointer;
    display: none;
  }

  #restartBtn:hover {
    background: #22c55e;
  }

  #controls-hint {
    margin-top: 10px;
    font-size: 13px;
    color: #888;
  }
</style>
</head>
<body>

  <h1>🐍 SNAKE</h1>
  <div id="scoreboard">
    <div>Score: <span id="score">0</span></div>
    <div>Best: <span id="highScore">0</span></div>
  </div>

  <canvas id="gameCanvas" width="400" height="400"></canvas>

  <div id="message"></div>
  <button id="restartBtn">Play Again</button>
  <div id="controls-hint">Use Arrow Keys or WASD to move</div>

<script>
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');
  const scoreEl = document.getElementById('score');
  const highScoreEl = document.getElementById('highScore');
  const messageEl = document.getElementById('message');
  const restartBtn = document.getElementById('restartBtn');

  const gridSize = 20;
  const tileCount = canvas.width / gridSize;

  let snake, direction, nextDirection, food, score, highScore, gameLoop, speed, gameOver;

  highScore = Number(localStorage_safeGet('snakeHighScore')) || 0;
  highScoreEl.textContent = highScore;

  // Fallback since localStorage may be restricted in some sandboxes
  function localStorage_safeGet(key) {
    try { return localStorage.getItem(key); } catch (e) { return null; }
  }
  function localStorage_safeSet(key, value) {
    try { localStorage.setItem(key, value); } catch (e) {}
  }

  function initGame() {
    snake = [
      { x: 10, y: 10 },
      { x: 9, y: 10 },
      { x: 8, y: 10 }
    ];
    direction = { x: 1, y: 0 };
    nextDirection = { x: 1, y: 0 };
    score = 0;
    speed = 120;
    gameOver = false;
    scoreEl.textContent = score;
    messageEl.textContent = '';
    restartBtn.style.display = 'none';
    placeFood();
    if (gameLoop) clearTimeout(gameLoop);
    runLoop();
  }

  function placeFood() {
    let valid = false;
    while (!valid) {
      food = {
        x: Math.floor(Math.random() * tileCount),
        y: Math.floor(Math.random() * tileCount)
      };
      valid = !snake.some(seg => seg.x === food.x && seg.y === food.y);
    }
  }

  function runLoop() {
    if (gameOver) return;
    update();
    draw();
    gameLoop = setTimeout(runLoop, speed);
  }

  function update() {
    direction = nextDirection;
    const head = { x: snake[0].x + direction.x, y: snake[0].y + direction.y };

    // Wall collision
    if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {
      return endGame();
    }

    // Self collision
    if (snake.some(seg => seg.x === head.x && seg.y === head.y)) {
      return endGame();
    }

    snake.unshift(head);

    if (head.x === food.x && head.y === food.y) {
      score++;
      scoreEl.textContent = score;
      if (speed > 60) speed -= 3;
      placeFood();
    } else {
      snake.pop();
    }
  }

  function draw() {
    ctx.fillStyle = '#0f0f1e';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Grid dots (subtle)
    ctx.fillStyle = '#1a1a2e';
    for (let i = 0; i < tileCount; i++) {
      for (let j = 0; j < tileCount; j++) {
        ctx.fillRect(i * gridSize, j * gridSize, gridSize - 1, gridSize - 1);
      }
    }

    // Food
    ctx.fillStyle = '#f87171';
    ctx.beginPath();
    ctx.arc(
      food.x * gridSize + gridSize / 2,
      food.y * gridSize + gridSize / 2,
      gridSize / 2 - 2,
      0, Math.PI * 2
    );
    ctx.fill();

    // Snake
    snake.forEach((seg, i) => {
      ctx.fillStyle = i === 0 ? '#4ade80' : '#22c55e';
      ctx.fillRect(seg.x * gridSize + 1, seg.y * gridSize + 1, gridSize - 2, gridSize - 2);
    });
  }

  function endGame() {
    gameOver = true;
    clearTimeout(gameLoop);
    if (score > highScore) {
      highScore = score;
      highScoreEl.textContent = highScore;
      localStorage_safeSet('snakeHighScore', highScore);
      messageEl.textContent = `Game Over! New high score: ${score} 🎉`;
    } else {
      messageEl.textContent = `Game Over! Final score: ${score}`;
    }
    restartBtn.style.display = 'inline-block';
  }

  document.addEventListener('keydown', (e) => {
    switch (e.key) {
      case 'ArrowUp':
      case 'w':
      case 'W':
        if (direction.y === 0) nextDirection = { x: 0, y: -1 };
        break;
      case 'ArrowDown':
      case 's':
      case 'S':
        if (direction.y === 0) nextDirection = { x: 0, y: 1 };
        break;
      case 'ArrowLeft':
      case 'a':
      case 'A':
        if (direction.x === 0) nextDirection = { x: -1, y: 0 };
        break;
      case 'ArrowRight':
      case 'd':
      case 'D':
        if (direction.x === 0) nextDirection = { x: 1, y: 0 };
        break;
    }
  });

  restartBtn.addEventListener('click', initGame);

  initGame();
</script>

</body>
</html>
